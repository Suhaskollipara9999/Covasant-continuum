# ══════════════════════════════════════════
# Covasant Continuum — Environment Config
# Copy to .env and fill in values
# ══════════════════════════════════════════

# ── Application ──
APP_NAME=Covasant Continuum
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-string-in-production
API_PREFIX=/api/v1

# ── Database ──
DATABASE_URL=postgresql+asyncpg://continuum:continuum_pass@localhost:5432/continuum_db

# ── JWT ──
JWT_SECRET_KEY=change-this-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Storage ──
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage/uploads
MAX_UPLOAD_SIZE_MB=100

# ── AI Providers (Super Admin configurable) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEFAULT_AI_PROVIDER=anthropic
DEFAULT_AI_MODEL=claude-sonnet-4-20250514

# ── Redis (for sessions/cache) ──
REDIS_URL=redis://localhost:6379/0

# ── Elasticsearch ──
ELASTICSEARCH_URL=http://localhost:9200

# ── Super Admin Bootstrap ──
SUPER_ADMIN_EMAIL=admin@covasant.com
SUPER_ADMIN_PASSWORD=change-this-password
